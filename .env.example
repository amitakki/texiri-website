NEXT_PUBLIC_SITE_URL=https://www.texiri.com
# Set to "production" ONLY on the production deployment. Anything else is noindex + robots Disallow.
NEXT_PUBLIC_SITE_ENV=

# Cloudflare Turnstile — leave both blank locally to skip verification.
# Cloudflare's always-pass test keys: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Form delivery (see docs/launch-checklist.md). With neither Resend nor the Sheet configured,
# local dev logs the form name only; any other environment rejects submissions.
RESEND_API_KEY=
LEAD_FROM="Texiri Solutions <website@texiri.com>"
LEAD_NOTIFY_TO=info@texiri.com
COMMUNITY_NOTIFY_TO=
CAREERS_NOTIFY_TO=
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# Optional rate limiting (5 submissions / 10 min / IP per form)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Step 7
CRM_PROVIDER=
